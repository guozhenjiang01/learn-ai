<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 测试环境日志 -->
    <appender name="STAGING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs-staging/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>logs-staging/app.%i.log.gz</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>5</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>5MB</maxFileSize>
        </triggeringPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 线上环境日志 -->
    <appender name="PRODUCTION_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs-production/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>logs-production/app.%i.log.gz</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>5</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>5MB</maxFileSize>
        </triggeringPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <springProfile name="staging">
        <root level="INFO">
            <appender-ref ref="STAGING_FILE"/>
        </root>
    </springProfile>

    <springProfile name="production">
        <root level="INFO">
            <appender-ref ref="PRODUCTION_FILE"/>
        </root>
    </springProfile>

    <springProfile name="!staging &amp; !production">
        <root level="INFO">
            <appender-ref ref="STAGING_FILE"/>
        </root>
    </springProfile>
</configuration>
